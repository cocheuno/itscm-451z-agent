ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
SN_INSTANCE=https://devNNNNNN.service-now.com
# Non-interactive service account: the PDI refuses REST basic auth for interactive users (admin included).
# Create it with web_service_access_only + internal_integration_user and roles itil + itil_admin (ADR-0002).
SN_USER=agent_svc
SN_PASSWORD="..."
MAX_COST_PER_RUN_USD=1.00
# dry_run: the write tools check everything and return what they would change; nothing reaches the PDI.
# live: approved writes are made. Switch per lecture 07b; never leave it on live between sessions.
AGENT_MODE=dry_run
# Which trained category model the agent serves (src/agent/models/category-v<version>). Empty = newest.
CATEGORY_MODEL_VERSION=
